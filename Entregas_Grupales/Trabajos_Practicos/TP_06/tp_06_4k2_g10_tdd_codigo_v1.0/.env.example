# Envio real del correo de confirmacion (opcional).
# Sin estas variables la demo muestra una vista previa del correo en pantalla.
# Para Gmail, SMTP_PASS es una "contrasena de aplicacion" (no la clave de la cuenta).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=cuenta@gmail.com
SMTP_PASS=contrasena-de-aplicacion
SMTP_FROM=EcoHarmony Park <cuenta@gmail.com>
